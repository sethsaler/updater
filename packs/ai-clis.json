{
  "description": "Optional overlay pack: self-updaters, go install module paths, vendor reinstallers, and policy overrides. Merge into config.local.json with: python3 lib_update_all_clis.py merge-pack packs/ai-clis.json ~/.config/update-all-clis/config.local.json",
  "known": {
    "agent": "agent update",
    "amp": "amp update 2>/dev/null",
    "atuin": "atuin update 2>/dev/null",
    "bumblebee": "go install github.com/perplexityai/bumblebee/cmd/bumblebee@latest 2>/dev/null",
    "claude": "claude update 2>/dev/null",
    "composio": "composio upgrade 2>/dev/null",
    "devin": "script -q /dev/null devin update 2>/dev/null",
    "espn-pp-cli": "go install github.com/mvanhorn/printing-press-library/library/media-and-entertainment/espn/cmd/espn-pp-cli@latest 2>/dev/null",
    "fireconnect": "fireconnect upgrade 2>/dev/null",
    "flight-goat-pp-cli": "go install github.com/mvanhorn/printing-press-library/library/travel/flight-goat/cmd/flight-goat-pp-cli@latest 2>/dev/null",
    "flora": "go install github.com/florafauna-ai/flora-cli/cmd/flora@latest 2>/dev/null",
    "goimports": "go install golang.org/x/tools/cmd/goimports@latest 2>/dev/null",
    "goose": "goose update 2>/dev/null",
    "gopls": "go install golang.org/x/tools/gopls@latest 2>/dev/null",
    "herdr": "herdr update 2>/dev/null",
    "hermes": "hermes update",
    "kimi": "kimi update 2>/dev/null",
    "lildax": "npm update -g @opencode-ai/cli --prefix $HOME/.local 2>/dev/null",
    "mimo": "curl -fsSL https://mimo.xiaomi.com/install | bash 2>/dev/null",
    "movie-goat-pp-cli": "go install github.com/mvanhorn/printing-press-library/library/media-and-entertainment/movie-goat/cmd/movie-goat-pp-cli@latest 2>/dev/null",
    "muse": "MUSE_LAUNCHER_INSTALL=1 muse 2>/dev/null",
    "ntn": "ntn update 2>/dev/null",
    "ollama": "ollama update 2>/dev/null",
    "omp": "omp update 2>/dev/null",
    "op": "op update 2>/dev/null",
    "pi": "pi update --all --no-approve 2>/dev/null",
    "pool": "pool update 2>/dev/null",
    "pplx": "pplx update 2>/dev/null",
    "prime-agent": "prime-agent update 2>/dev/null",
    "printing-press": "go install github.com/mvanhorn/cli-printing-press/v4/cmd/printing-press@latest 2>/dev/null",
    "qwen": "qwen update 2>/dev/null",
    "recipe-goat-pp-cli": "go install github.com/mvanhorn/printing-press-library/library/food-and-dining/recipe-goat/cmd/recipe-goat-pp-cli@latest 2>/dev/null",
    "starship": "starship self-update 2>/dev/null",
    "warp": "warp-cli update 2>/dev/null",
    "zoxide": "zoxide update 2>/dev/null || zoxide self-update 2>/dev/null"
  }
}
