{
  "known": {
    "agent": "agent update",
    "amp": "amp update 2>/dev/null",
    "aside": "aside update --yes",
    "atuin": "atuin update 2>/dev/null",
    "bumblebee": "go install github.com/perplexityai/bumblebee/cmd/bumblebee@latest 2>/dev/null",
    "claude": "claude update 2>/dev/null",
    "claude-science": "bash \"${LIB_SCRIPT%/*}/scripts/update_packages.sh\" claude-science",
    "cli-printing-press": "go install github.com/mvanhorn/cli-printing-press/v4/cmd/cli-printing-press@latest",
    "composio": "composio upgrade 2>/dev/null",
    "devin": "script -q /dev/null devin update 2>/dev/null",
    "droid": "droid update",
    "espn-pp-cli": "go install github.com/mvanhorn/printing-press-library/library/media-and-entertainment/espn/cmd/espn-pp-cli@latest 2>/dev/null",
    "fireconnect": "fireconnect upgrade 2>/dev/null",
    "flight-goat-pp-cli": "go install github.com/mvanhorn/printing-press-library/library/travel/flight-goat/cmd/flight-goat-pp-cli@latest 2>/dev/null",
    "flora": "go install github.com/florafauna-ai/flora-cli/cmd/flora@latest 2>/dev/null",
    "goimports": "go install golang.org/x/tools/cmd/goimports@latest 2>/dev/null",
    "goose": "python3 \"${LIB_SCRIPT%/*}/scripts/update_goose.py\"",
    "gopls": "go install golang.org/x/tools/gopls@latest 2>/dev/null",
    "herdr": "herdr update 2>/dev/null",
    "herdr-core": "herdr-core update",
    "hermes": "hermes update",
    "kimi": "kimi update 2>/dev/null",
    "lildax": "npm update -g @opencode-ai/cli --prefix $HOME/.local 2>/dev/null",
    "mimo": "bash \"${LIB_SCRIPT%/*}/scripts/update_packages.sh\" mimo",
    "movie-goat-pp-cli": "go install github.com/mvanhorn/printing-press-library/library/media-and-entertainment/movie-goat/cmd/movie-goat-pp-cli@latest 2>/dev/null",
    "muse": "MUSE_LAUNCHER_INSTALL=1 muse 2>/dev/null",
    "ntn": "ntn update 2>/dev/null",
    "omp": "omp update 2>/dev/null",
    "op": "op update 2>/dev/null",
    "pi": "pi update --all --no-approve 2>/dev/null",
    "pool": "pool update 2>/dev/null",
    "pplx": "pplx update 2>/dev/null",
    "prime-agent": "prime-agent update 2>/dev/null",
    "printing-press": "go install github.com/mvanhorn/cli-printing-press/v4/cmd/printing-press@latest 2>/dev/null",
    "qwen": "qwen update 2>/dev/null",
    "raft-computer": "python3 \"${LIB_SCRIPT%/*}/scripts/update_raft.py\"",
    "recipe-goat-pp-cli": "go install github.com/mvanhorn/printing-press-library/library/food-and-dining/recipe-goat/cmd/recipe-goat-pp-cli@latest 2>/dev/null",
    "starship": "starship self-update 2>/dev/null",
    "warp": "warp-cli update 2>/dev/null",
    "zoxide": "zoxide update 2>/dev/null || zoxide self-update 2>/dev/null"
  },
  "bulk": {
    "npm": "python3 \"${LIB_SCRIPT%/*}/scripts/update_npm_globals.py\"",
    "pnpm": "pnpm update -g 2>/dev/null",
    "yarn": "yarn global upgrade 2>/dev/null",
    "cargo": "bash \"$(dirname \"$LIB_SCRIPT\")/scripts/update_packages.sh\" cargo",
    "gem": "python3 \"${LIB_SCRIPT%/*}/scripts/update_user_packages.py\" gem",
    "brew": "brew update && HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ASK=1 brew upgrade --greedy-auto-updates --no-quit",
    "manual": "",
    "conda": "conda update --all -y 2>/dev/null",
    "uv": "python3 \"$(dirname \"$LIB_SCRIPT\")/scripts/update_uv.py\"",
    "uv/pip": "python3 \"$(dirname \"$LIB_SCRIPT\")/scripts/update_uv.py\"",
    "uv/venv": "python3 \"$(dirname \"$LIB_SCRIPT\")/scripts/update_uv.py\"",
    "fnm": "fnm update 2>/dev/null",
    "bun": "bash \"$(dirname \"$LIB_SCRIPT\")/scripts/update_packages.sh\" bun",
    "deno": "deno upgrade 2>/dev/null",
    "pyenv": "pyenv update 2>/dev/null",
    "rbenv": "brew upgrade rbenv ruby-build 2>/dev/null",
    "sdkman": "bash -lc 'test -s \"$HOME/.sdkman/bin/sdkman-init.sh\" && . \"$HOME/.sdkman/bin/sdkman-init.sh\" && sdk selfupdate'",
    "opencode": "opencode upgrade 2>/dev/null",
    "go": "",
    "headlong": "bash \"${LIB_SCRIPT%/*}/scripts/update_packages.sh\" headlong",
    "browser-use-terminal": "\"$HOME/.local/bin/browser-use-terminal\" update",
    "entire": "python3 \"${LIB_SCRIPT%/*}/scripts/update_entire.py\"",
    "gemini-api": "python3 \"${LIB_SCRIPT%/*}/scripts/update_standalone_release.py\" gemini-api",
    "jevgram": "python3 \"${LIB_SCRIPT%/*}/scripts/update_jevgram.py\"",
    "superwhisper": "python3 \"${LIB_SCRIPT%/*}/scripts/update_standalone_release.py\" superwhisper",
    "unsloth": "python3 \"${LIB_SCRIPT%/*}/scripts/update_unsloth.py\"",
    "openinterpreter": "current=\"$HOME/.openinterpreter/packages/standalone/current\"; if [ -x \"$current/bin/interpreter\" ]; then \"$current/bin/interpreter\" update; else \"$current/interpreter\" update now; fi",
    "dotnet": "dotnet tool update --global 2>/dev/null",
    "krew": "kubectl krew upgrade 2>/dev/null",
    "mise": "mise self-update 2>/dev/null",
    "pipx": "pipx upgrade-all 2>/dev/null",
    "grok": "v=$(grok --version) && case \"$v\" in *\"[alpha]\"*) grok update --alpha ;; *) grok update ;; esac",
    "rustup": "rustup update 2>/dev/null",
    "gcloud": "gcloud components update --quiet 2>/dev/null",
    "mas": "mas upgrade 2>/dev/null",
    "tlmgr": "tlmgr update --self --all 2>/dev/null",
    "pip": "python3 \"${LIB_SCRIPT%/*}/scripts/update_user_packages.py\" pip",
    "asdf": "asdf update 2>/dev/null",
    "proto": "proto update 2>/dev/null",
    "volta": "volta update 2>/dev/null",
    "rye": "rye self update 2>/dev/null",
    "foundry": "foundryup 2>/dev/null",
    "aqua": "aqua update 2>/dev/null",
    "mason": "command -v nvim >/dev/null 2>&1 && nvim --headless \"+lua local ok,r=pcall(require,'mason-registry') if not ok then return end r.refresh() local ps={} for _,p in ipairs(r.get_installed_packages()) do table.insert(ps,p.name) end if #ps>0 then vim.cmd('MasonInstall '..table.concat(ps,' ')) end\" +qa 2>/dev/null",
    "path": ""
  },
  "check": {
    "npm": "python3 \"${LIB_SCRIPT%/*}/scripts/update_npm_globals.py\" --check",
    "brew": "brew update >/dev/null && brew outdated --greedy-auto-updates --quiet"
  },
  "fix": {
    "amp": "curl -fsSL https://ampcode.com/install.sh | bash",
    "composio": "curl -fsSL https://composio.dev/install | COMPOSIO_INSTALL_SHELL=none sh"
  },
