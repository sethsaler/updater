{
  "known": {
    "agent": "agent update",
    "amp": "amp update 2>/dev/null",
    "atuin": "atuin update 2>/dev/null",
    "bumblebee": "go install github.com/perplexityai/bumblebee/cmd/bumblebee@latest 2>/dev/null",
    "claude": "claude update 2>/dev/null",
    "composio": "composio upgrade 2>/dev/null",
    "devin": "script -q /dev/null devin update 2>/dev/null",
    "espn-pp-cli": "go install github.com/mvanhorn/printing-press-library/library/media-and-entertainment/espn/cmd/espn-pp-cli@latest 2>/dev/null",
    "fireconnect": "fireconnect upgrade 2>/dev/null",
    "flight-goat-pp-cli": "go install github.com/mvanhorn/printing-press-library/library/travel/flight-goat/cmd/flight-goat-pp-cli@latest 2>/dev/null",
    "flora": "go install github.com/florafauna-ai/flora-cli/cmd/flora@latest 2>/dev/null",
    "goimports": "go install golang.org/x/tools/cmd/goimports@latest 2>/dev/null",
    "goose": "goose update 2>/dev/null",
    "gopls": "go install golang.org/x/tools/gopls@latest 2>/dev/null",
    "herdr": "herdr update 2>/dev/null",
    "hermes": "hermes update",
    "kimi": "kimi update 2>/dev/null",
    "lildax": "npm update -g @opencode-ai/cli --prefix $HOME/.local 2>/dev/null",
    "mimo": "curl -fsSL https://mimo.xiaomi.com/install | bash 2>/dev/null",
    "movie-goat-pp-cli": "go install github.com/mvanhorn/printing-press-library/library/media-and-entertainment/movie-goat/cmd/movie-goat-pp-cli@latest 2>/dev/null",
    "muse": "MUSE_LAUNCHER_INSTALL=1 muse 2>/dev/null",
    "ntn": "ntn update 2>/dev/null",
    "ollama": "ollama update 2>/dev/null",
    "omp": "omp update 2>/dev/null",
    "op": "op update 2>/dev/null",
    "pi": "pi update --all --no-approve 2>/dev/null",
    "pool": "pool update 2>/dev/null",
    "pplx": "pplx update 2>/dev/null",
    "prime-agent": "prime-agent update 2>/dev/null",
    "printing-press": "go install github.com/mvanhorn/cli-printing-press/v4/cmd/printing-press@latest 2>/dev/null",
    "qwen": "qwen update 2>/dev/null",
    "recipe-goat-pp-cli": "go install github.com/mvanhorn/printing-press-library/library/food-and-dining/recipe-goat/cmd/recipe-goat-pp-cli@latest 2>/dev/null",
    "starship": "starship self-update 2>/dev/null",
    "warp": "warp-cli update 2>/dev/null",
    "zoxide": "zoxide update 2>/dev/null || zoxide self-update 2>/dev/null"
  },
  "bulk": {
    "npm": "npm outdated -g --parseable 2>/dev/null | cut -d: -f2 | sed 's/@[^@]*$//' | sort -u | while read -r p; do npm update -g \"$p\" --no-fund --no-audit 2>/dev/null || true; done",
    "pnpm": "pnpm update -g 2>/dev/null",
    "yarn": "yarn global upgrade 2>/dev/null",
    "cargo": "cargo install-update -a 2>/dev/null || cargo update",
    "gem": "gem update --user-install 2>&1 | grep -v -E 'BUILD_RUBY_PLATFORM|fiddle|compiling|make:|error:|Error:|warnings generated' || true",
    "brew": "brew --repository >/dev/null && brew update && brew upgrade 2>&1 | grep -v 'Warning:' | head -200 || true",
    "manual": "brew upgrade 2>/dev/null || true",
    "conda": "conda update --all -y 2>/dev/null || true",
    "uv": "uv self update && uv tool upgrade --all",
    "uv/pip": "uv self update && uv tool upgrade --all",
    "uv/venv": "uv self update && uv tool upgrade --all",
    "fnm": "fnm update 2>/dev/null || true",
    "bun": "curl -fsSL https://bun.com/install | bash 2>/dev/null || true; bun update -g 2>/dev/null || true",
    "deno": "deno upgrade 2>/dev/null || true",
    "pyenv": "pyenv update 2>/dev/null || true",
    "rbenv": "brew upgrade rbenv ruby-build 2>/dev/null || true",
    "sdkman": "bash -lc 'test -s \"$HOME/.sdkman/bin/sdkman-init.sh\" && . \"$HOME/.sdkman/bin/sdkman-init.sh\" && sdk selfupdate'",
    "opencode": "opencode upgrade 2>/dev/null || true",
    "go": "",
    "dotnet": "dotnet tool update --global 2>/dev/null || true",
    "krew": "kubectl krew upgrade 2>/dev/null || true",
    "mise": "mise self-update 2>/dev/null || true",
    "pipx": "pipx upgrade-all 2>/dev/null || true",
    "grok": "grok update 2>/dev/null || true",
    "rustup": "rustup update 2>/dev/null || true",
    "gcloud": "gcloud components update --quiet 2>/dev/null",
    "mas": "mas upgrade 2>/dev/null || true",
    "tlmgr": "tlmgr update --self --all 2>/dev/null",
    "pip": "pip3 install --upgrade pip setuptools wheel 2>/dev/null || true",
    "asdf": "asdf update 2>/dev/null || true",
    "proto": "proto update 2>/dev/null || true",
    "volta": "volta update 2>/dev/null || true",
    "rye": "rye self update 2>/dev/null || true",
    "foundry": "foundryup 2>/dev/null || true",
    "aqua": "aqua update 2>/dev/null || true",
    "mason": "command -v nvim >/dev/null 2>&1 && nvim --headless \"+lua local ok,r=pcall(require,'mason-registry') if not ok then return end r.refresh() local ps={} for _,p in ipairs(r.get_installed_packages()) do table.insert(ps,p.name) end if #ps>0 then vim.cmd('MasonInstall '..table.concat(ps,' ')) end\" +qa 2>/dev/null",
    "path": ""
  },
  "check": {
    "npm": "npm outdated -g --parseable",
    "brew": "brew update >/dev/null 2>&1 && brew outdated --quiet"
  },
  "scan_dirs": [
    {
      "dir": "$HOME/.local/bin",
      "origin": "uv/pip"
    },
    {
      "dir": "$HOME/.cargo/bin",
      "origin": "cargo"
    },
    {
      "dir": "$HOME/.deno/bin",
      "origin": "deno"
    },
    {
      "dir": "$HOME/.bun/bin",
      "origin": "bun"
    },
    {
      "dir": "$HOME/.bun/install/cache/bin",
      "origin": "bun"
    },
    {
      "dir": "$HOME/.rbenv/shims",
      "origin": "rbenv"
    },
    {
      "dir": "$HOME/.pyenv/shims",
      "origin": "pyenv"
    },
    {
      "dir": "$HOME/.npm-global/lib/node_modules/.bin",
      "origin": "npm"
    },
    {
      "dir": "$HOME/.npm-global/bin",
      "origin": "npm"
    },
    {
      "dir": "$HOME/go/bin",
      "origin": "go"
    },
    {
      "dir": "$HOME/miniconda3/bin",
      "origin": "conda"
    },
    {
      "dir": "$HOME/anaconda3/bin",
      "origin": "conda"
    },
    {
      "dir": "$HOME/mambaforge/bin",
      "origin": "conda"
    },
    {
      "dir": "$HOME/miniforge3/bin",
      "origin": "conda"
    },
    {
      "dir": "$HOME/micromamba/bin",
      "origin": "conda"
    },
    {
      "dir": "$HOME/.local/share/venv",
      "origin": "uv/venv",
      "mode": "tree"
    },
    {
      "dir": "/usr/local/bin",
      "origin": "manual"
    },
    {
      "dir": "$HOME/.opencode/bin",
      "origin": "opencode"
    },
    {
      "dir": "$HOME/.grok/bin",
      "origin": "grok"
    },
    {
      "dir": "$HOME/bin",
      "origin": "manual"
    },
    {
      "dir": "$HOME/.yarn/bin",
      "origin": "yarn"
    },
    {
      "dir": "$HOME/.config/yarn/global/node_modules/.bin",
      "origin": "yarn"
    },
    {
      "dir": "$HOME/.dotnet/tools",
      "origin": "dotnet"
    },
    {
      "dir": "$HOME/.krew/bin",
      "origin": "krew"
    },
    {
      "dir": "$HOME/.local/share/mise/shims",
      "origin": "mise"
    },
    {
      "dir": "$HOME/.local/share/mise/installs",
      "origin": "mise",
      "mode": "tree"
    },
    {
      "dir": "/opt/local/bin",
      "origin": "manual"
    },
    {
      "dir": "$HOME/.wasmtime/bin",
      "origin": "manual"
    },
    {
      "dir": "$HOME/.wasmer/bin",
      "origin": "manual"
    },
    {
      "dir": "$HOME/.volta/bin",
      "origin": "volta"
    },
    {
      "dir": "$HOME/.asdf/shims",
      "origin": "asdf"
    },
    {
      "dir": "$HOME/.proto/bin",
      "origin": "proto"
    },
    {
      "dir": "$HOME/.rye/shims",
      "origin": "rye"
    },
    {
      "dir": "$HOME/.local/share/rye/shims",
      "origin": "rye"
    },
    {
      "dir": "$HOME/.foundry/bin",
      "origin": "foundry"
    },
    {
      "dir": "$HOME/.aqua/bin",
      "origin": "aqua"
    },
    {
      "dir": "$HOME/.local/share/aquaproj-aqua/bin",
      "origin": "aqua"
    },
    {
      "dir": "$HOME/.local/share/nvim/mason/bin",
      "origin": "mason"
    }
  ],
  "hold": [],
  "repos": {
    "gh": "cli/cli",
    "fzf": "junegunn/fzf",
    "rg": "BurntSushi/ripgrep",
    "starship": "starship/starship",
    "uv": "astral-sh/uv",
    "deno": "denoland/deno",
    "bun": "oven-sh/bun",
    "zoxide": "ajeetdsouza/zoxide",
    "eza": "eza-community/eza",
    "bat": "sharkdp/bat",
    "fd": "sharkdp/fd",
    "just": "casey/just",
    "lazygit": "jesseduffield/lazygit",
    "yazi": "sxyazi/yazi",
    "atuin": "atuinsh/atuin",
    "mise": "jdx/mise",
    "gemini": "google-gemini/gemini-cli",
    "opencode": "sst/opencode",
    "rustup": "rust-lang/rustup",
    "mas": "mas-cli/mas",
    "prime-agent": "PrimeIntellect-ai/prime-agent"
  }
}
